# Copy this file to .env and uncomment one provider configuration.

# OpenRouter (defaults to moonshotai/kimi-k3)
# CHRONICLER_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=moonshotai/kimi-k3

# Anthropic
# CHRONICLER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# OpenAI
# CHRONICLER_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_FAST_MODEL=gpt-5.6-luna

# Ollama / local OpenAI-compatible server
# CHRONICLER_PROVIDER=local
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3.6:35b-a3b

# Another OpenAI-compatible server (a real key is optional for custom URLs)
# CHRONICLER_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_MODEL=your-model
# OPENAI_FAST_MODEL=your-model

# Provider-independent model overrides:
# CHRONICLER_MODEL=provider/model-name
# CHRONICLER_FAST_MODEL=provider/fast-model-name

# Selection and security details: docs/PROVIDERS.md
